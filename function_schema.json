{
  "type": "function",
  "function": {
    "name": "TextureBlindBoxDraw",
    "description": "纹理顺势盲盒创意绘画，对用户实拍图片做局部简笔涂鸦增量，保留原图70%以上实拍信息，不做全盘重绘。",
    "parameters": {
      "type": "object",
      "required": ["user_image_ref"],
      "properties": {
        "user_image_ref": {
          "type": "string",
          "description": "用户上传图片的引用标识"
        },
        "user_text_prompt": {
          "type": "string",
          "description": "用户附加的创意文字指令，可为空字符串",
          "default": ""
        },
        "force_mode": {
          "type": "string",
          "enum": ["","CrackTrace","ObjectAnthropo","MicroWorld","SymbolDecorate","CustomFree"],
          "description": "强制指定工作模式，空字符串代表自动识别",
          "default": ""
        },
        "force_intensity": {
          "type": ["integer","null"],
          "minimum":1,
          "maximum":5,
          "description":"强制强度档位，null为自动使用默认2档",
          "default":null
        },
        "creative_theme": {
          "type": "string",
          "enum": [
            "",
            "healing-daily-life",
            "urban-archaeology",
            "micro-adventure",
            "absurd-humor",
            "mystery-discovery",
            "hidden-fairy-tale",
            "minimal-art"
          ],
          "description": "隐藏事件的创意主题，空字符串代表根据照片自动选择",
          "default": ""
        },
        "event_seed": {
          "type": "string",
          "description": "用户指定的隐藏事件、动作或剧情线索，可为空字符串",
          "default": ""
        }
      }
    }
  }
}
